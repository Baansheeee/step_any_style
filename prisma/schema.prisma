generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid()) @map("_id")
  email        String   @unique
  password     String
  name         String?
  role         UserRole @default(USER)
  adminKeyUsed Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  influencerProfile InfluencerProfile?
  orders            Order[]
}

model PromoCode {
  id              String   @id @default(cuid()) @map("_id")
  code            String   @unique
  discountPercent Int
  validUntil      DateTime
  prefix          String?
  usageCount      Int      @default(0)
  totalGrossSales Float    @default(0)
  totalDiscount   Float    @default(0)
  influencerId    String?
  influencer      InfluencerProfile? @relation(fields: [influencerId], references: [id])
  orders          Order[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model InfluencerProfile {
  id             String            @id @default(cuid()) @map("_id")
  userId         String            @unique
  defaultPrefix  String
  commissionRate Float             @default(0.1)
  status         InfluencerStatus  @default(ACTIVE)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  user           User              @relation(fields: [userId], references: [id])
  promoCodes     PromoCode[]
}

model Order {
  id             String      @id @default(cuid()) @map("_id")
  userId         String?
  promoCodeId    String?
  subtotal       Float       
  discountAmount Float       
  shippingCost   Float       @default(0)
  total          Float
  status         OrderStatus @default(PENDING)
  paymentMethod  PaymentMethod
  paymentStatus  PaymentStatus @default(PENDING)
  paymentIntentId String?
  receiptUrl     String?
  directAccount  String?
  shippingName   String
  shippingEmail  String
  shippingPhone  String
  shippingAddress String
  shippingCity    String
  shippingRegion  String
  shippingPostalCode String
  items          Json
  adminNote      String?
  approvedAt     DateTime?
  disapprovedAt  DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  user           User?       @relation(fields: [userId], references: [id])
  promoCode      PromoCode?  @relation(fields: [promoCodeId], references: [id])
}

enum UserRole {
  USER
  ADMIN
  INFLUENCER
}

enum PaymentMethod {
  CARD
  DIRECT
  COD
}

enum PaymentStatus {
  PENDING
  APPROVED
  DISAPPROVED
}

enum InfluencerStatus {
  ACTIVE
  SUSPENDED
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  COMPLETED
  CANCELLED
}

enum Gender {
  MEN
  WOMEN
  KIDS
  UNISEX
}

model AffiliateApplication {
  id            String                    @id @default(cuid()) @map("_id")
  email         String
  channelLink1  String
  channelLink2  String?
  status        AffiliateApplicationStatus @default(PENDING)
  reviewedBy    String?
  reviewedAt    DateTime?
  notes         String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
}

enum AffiliateApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Product {
  id               String   @id @default(cuid()) @map("_id")
  slug             String   @unique
  name             String
  description      String
  shortDescription String
  price            Float
  originalPrice    Float?
  discount         Int?     @default(0)
  inStock          Boolean  @default(true)
  image            String?
  images           Json?
  videoUrl         String?
  advantages       Json?
  specifications   Json?
  features         Json?
  variants         Json?   @default("[]")
  collectionId     String?
  collection       Collection? @relation(fields: [collectionId], references: [id])
  reviews          Review[]
  rating           Float    @default(0)
  saleCount        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Review {
  id        String   @id @default(cuid()) @map("_id")
  rating    Int
  comment   String
  userName  String
  userEmail String?
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  isFeatured Boolean @default(false)
  images     Json?
  videoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Collection {
  id           String    @id @default(cuid()) @map("_id")
  name         String    @unique
  slug         String    @unique
  description  String?
  image        String?
  targetGender Gender    @default(UNISEX)
  products     Product[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model ShippingRegion {
  id           String    @id @default(cuid()) @map("_id")
  name         String    @unique
  shippingCost Float     @default(0)
  cities       ShippingCity[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model ShippingCity {
  id            String  @id @default(cuid()) @map("_id")
  name          String
  regionId      String
  region        ShippingRegion @relation(fields: [regionId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([name, regionId])
}

model SaleEvent {
  id                String   @id @default(cuid()) @map("_id")
  name              String   @unique
  bannerText        String
  discountPercent   Int      @default(0)
  targetCollections Json?    // Array of collection IDs
  targetProducts    Json?    // Array of product IDs
  isActive          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Blog {
  id          String   @id @default(cuid()) @map("_id")
  slug        String   @unique
  title       String
  description String
  content     String
  image       String?
  images      Json?
  videoUrl    String?
  author      String?
  category    String?
  tags        Json?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
